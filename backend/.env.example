# ==============================================================================
# DineMaster Spring Boot Backend Environment Configuration
# Copy this file to .env and replace placeholder values with actual secrets.
# DO NOT commit real secrets or .env file to version control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dinemaster
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password
JPA_DDL_AUTO=update

# JWT Authentication
JWT_SECRET=your_base64_or_hex_jwt_secret_key_minimum_256_bits_for_hmac_sha256
JWT_EXPIRATION_MS=86400000

# Cloudinary Integration (Image & Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway Integration (Kept strictly on backend - Never exposed to frontend)
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_KEY_ID=your_payment_gateway_key_id
PAYMENT_GATEWAY_KEY_SECRET=your_payment_gateway_key_secret
PAYMENT_GATEWAY_WEBHOOK_SECRET=your_payment_gateway_webhook_secret
