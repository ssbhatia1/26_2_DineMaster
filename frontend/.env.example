# DineMaster Frontend Environment Configuration
# Copy this file to .env and adjust variables as needed

# Mode: 'local' (standalone SQLite + Shelf) or 'client' (connect to backend / server)
APP_MODE=local

# Backend API configuration (Spring Boot Backend)
API_BASE_URL=http://localhost:8081/api
BACKEND_HOST=localhost
BACKEND_PORT=8081

# Embedded local server configuration
LOCAL_SERVER_IP=127.0.0.1
LOCAL_SERVER_PORT=8080

# Environment: development | staging | production
APP_ENV=development
